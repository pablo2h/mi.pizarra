# Copiá este archivo a .env y completá los valores antes de levantar el stack.
# cp .env.example .env

# Contraseña de la base de datos Postgres usada por Vikunja.
VIKUNJA_DB_PASSWORD=cambiar-esta-clave

# Clave secreta usada por Vikunja para firmar tokens de sesión (JWT).
# Generar una aleatoria, por ejemplo: openssl rand -hex 32
VIKUNJA_JWT_SECRET=cambiar-esta-clave-tambien

# URL pública donde vas a acceder a Vikunja (usada para links en emails, etc).
# Si sólo lo usás en tu red local podés dejar el valor por defecto.
VIKUNJA_PUBLIC_URL=http://localhost:3456

# Puerto en el que Vikunja va a quedar expuesto en el host.
VIKUNJA_PORT=3456

# Token del túnel de Cloudflare (solo necesario si vas a exponer Vikunja
# con `docker compose --profile tunnel up -d`). Ver README, sección
# "Exponerlo con Cloudflare Tunnel", para cómo generarlo.
CLOUDFLARE_TUNNEL_TOKEN=
